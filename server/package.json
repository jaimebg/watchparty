{
  "name": "watchparty-server",
  "description": "Fastify server that transcodes video to HLS, syncs playback and tunnels guests in.",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "setup": "tsx src/setup/setup.ts",
    "preflight": "tsx src/setup/preflight.ts",
    "tunnel:up": "tsx src/setup/tunnel-cli.ts up",
    "tunnel:down": "tsx src/setup/tunnel-cli.ts down",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^9.3.1",
    "@fastify/static": "^7.0.4",
    "@fastify/websocket": "^10.0.1",
    "fastify": "^4.28.1",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.0.3",
    "ws": "^8.18.0",
    "@types/ws": "^8.5.10",
    "@types/node": "^20.14.10"
  }
}
